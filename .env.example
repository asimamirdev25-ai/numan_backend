NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
TZ=Asia/Karachi

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/numan_cables

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER_EXPIRES=30d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin seed (used by npm run seed)
ADMIN_NAME=Numan Admin
ADMIN_PHONE=+923001234567
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@numancables.com

# Shop contact (seeded into Settings)
SHOP_WHATSAPP=+923157221702
SHOP_NAME=Numan Cables
SHOP_EMAIL=info@numancables.com

# Google Sign-In (optional at launch)
GOOGLE_CLIENT_ID=

# OTP (disabled by default – free-first launch)
OTP_ENABLED=false
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=console

# Uploads — local (dev) or cloudinary (Render / production)
# Dashboard: https://console.cloudinary.com → Account Details
UPLOAD_DRIVER=cloudinary
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Business defaults
# true = new shops need admin approval before ordering
REQUIRE_APPROVAL=true
STOCK_REDUCE_ON=placement
CURRENCY=PKR
